rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure user-specific isolation: users can only read and write their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections (routines, todos, reflections) inherit the same security constraint
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
